# The folder tree follows the current folder and can start at the current folder.
action win.tree-root current
open $T/a
expect-tree-root $T/a
wait-tree-selected $T/a
tree-click $T/a/b
expect-location $T/a/b
expect-tree-root $T/a/b
action win.tree-root root
open $T/a/b/c
# The tree's filesystem root: "/" on Unix, the volume root of the folder on Windows.
!unix expect-tree-root /
!win expect-tree-root $TROOT
wait-tree-selected $T/a/b/c
action win.up
expect-location $T/a/b
expect-selected c
wait-tree-selected $T/a/b
# One click on a triangle opens the folder (it used to collapse again while loading).
action win.tree-root current
open $T/a
wait-tree-selected $T/a
tree-expand $T/a/other
wait-tree-expanded $T/a/other
# The tree follows changes: new and removed folders appear and disappear.
open $T/a
wait-tree-children $T/a = b, other
text zeta
action win.new-folder
wait-tree-children $T/a = b, other, zeta
select zeta
action win.delete
wait-tree-children $T/a = b, other
# Clicking the tree while the drives page is shown opens the folder (it used to crash).
action win.tree-root current
open $T/a
wait-tree-children $T/a = b, other
action win.drives
!unix wait-drive File System
!win wait-drive $C
tree-click $T/a/b
expect-location $T/a/b
expect-tree-root $T/a/b
expect-page list
