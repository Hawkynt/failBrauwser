# Trash compatible with other file managers: files/ + info/*.trashinfo in the XDG data dir.
# On Windows the shell's Recycle Bin is the bin: same names, checked through the shell.
open $T/w
select a.txt
action win.trash
wait-missing $T/w/a.txt
!unix wait-exists $T/data/Trash/files/a.txt
!unix wait-exists $T/data/Trash/info/a.txt.trashinfo
!win wait-bin a.txt
open trash:///
expect-crumbs Trash
wait-row a.txt
select a.txt
trash-bar Restore
wait-exists $T/w/a.txt
wait-no-row a.txt
# Restoring onto a name that is taken again: keep both.
open $T/w
select a.txt
action win.trash
wait-missing $T/w/a.txt
write-file $T/w/a.txt = newer
open trash:///
wait-row a.txt
select a.txt
answer keepboth
action win.restore
wait-exists $T/w/a (2).txt
# Delete permanently, then empty the trash.
open $T/w
select b.txt
action win.trash
wait-missing $T/w/b.txt
select c.txt
action win.trash
wait-missing $T/w/c.txt
open trash:///
wait-row b.txt
select b.txt
action win.delete
!unix wait-missing $T/data/Trash/files/b.txt
!unix wait-missing $T/data/Trash/info/b.txt.trashinfo
!win wait-no-bin b.txt
# Emptying clears the bin on every drive — on Windows that is the machine's own
# Recycle Bin with its owner's files, so the button and the emptied-bin checks stay
# Linux-side; the per-item win.delete above covers the Windows permanent-delete path.
!unix trash-bar Empty Trash
!unix wait-missing $T/data/Trash/files/c.txt
!unix wait-no-row c.txt
!unix expect-rows 0
!unix expect-disabled win.restore
!unix expect-disabled win.empty-trash
!win wait-row c.txt
