# A disk image mounts like a drive from its right-click menu, shows in the side panel under
# its file name, and Eject takes it away again.
fake-image $T/backup.iso = $T/inside
open $T
select backup.iso
expect-menu-item Mount as Drive
select photos.zip
expect-no-menu-item Mount as Drive
select backup.iso
action win.mount-image
wait-location $T/inside
wait-row report.txt
wait-side-drive backup.iso : $T/inside
side-drive-menu backup.iso : $T/inside : Eject
wait-no-side-drive backup.iso
