# The path bar: a button per step from /, only up to where you are, text mode on demand.
open $T/a/b/c
expect-path-mode buttons
crumb-click b
expect-location $T/a/b
# Going up drops the deeper steps.
crumb-click a
expect-location $T/a
# The root step: "/" on Unix, the volume root on Windows ($TROOT: the drive $T is on).
!unix crumb-click /
!unix expect-location /
!win crumb-click $TROOT
!win expect-location $TROOT
open $T/x
crumb-click x
expect-location $T/x
# Text mode: type a location, back to buttons afterwards.
path-edit
expect-path-mode text
type-location $T/a/b
expect-location $T/a/b
expect-path-mode buttons
path-edit
expect-path-mode text
action win.reload
# A long path in a narrow window still shows its last step.
size 520 400
open $T/a/b/c/a-rather-long-folder-name/another-long-folder-name/and-the-last-one
sleep 300
expect-last-crumb and-the-last-one
