# The Size column adds up folders recursively without following symlinks.
open $T/root
wait-cell size photos = 3.5 kB
wait-cell size with-link = 10 bytes
wait-cell size note.txt = 5 bytes
# Switching the column off and on again recomputes.
action win.column-size
action win.column-size
wait-cell size photos = 3.5 kB
